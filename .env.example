# Copy to `.env` in the project root (never commit `.env`).
# Required for `npm run dev:server` / `npm start`:

MONGO_URI=mongodb://127.0.0.1:27017/pawlink
JWT_SECRET=change_me_to_a_long_random_string

# Express listens here; `npm run dev:client` proxies /auth, /dogs, /applications to the same port.
PORT=5000

# Client data source: mock | hybrid | api (code default is mock — bundled mock listings and image URLs).
VITE_DATA_MODE=mock

# Optional: client calls API directly (e.g. preview build without Vite proxy)
# VITE_API_URL=http://127.0.0.1:5000

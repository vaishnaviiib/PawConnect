# Copy to `.env.test` in the project root for Jest (never commit `.env.test`).
# Use a dedicated MongoDB database; tests drop the DB after the suite.

MONGO_URI=mongodb://127.0.0.1:27017/pawlink_test
JWT_SECRET=test_change_me_for_jest

# Optional: overrides database name (default is pawlink_test in tests/integration/setup.js)
# MONGO_DB_NAME=pawlink_test

{
  "name": "pawconnect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PawConnect full-stack app",
  "main": "server.js",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "nodemon server.js",
    "dev": "vite",
    "start": "node server.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "cross-env NODE_ENV=test VITE_DATA_MODE=hybrid NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.unit.mjs --runInBand",
    "test:integration": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.integration.mjs --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaishnaviiib/PawConnect.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vaishnaviiib/PawConnect/issues"
  },
  "homepage": "https://github.com/vaishnaviiib/PawConnect#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vite": "^8.0.4"
  }
}
